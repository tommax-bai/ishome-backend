<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  代码级命名规范的 CI 执行（开发规范 §2.1 / §2.2 / §4.1）。
  格式化交给 Spotless（google-java-format），本文件只管命名禁令。
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <module name="TreeWalker">
    <module name="UnusedImports"/>

    <!-- 规范 §2.1：禁用类后缀。兜底名是"不知道该叫什么"的自首；MQ/事件入口用 XxxConsumer -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="\b(class|interface|enum|record)\s+\w+(Manager|Helper|Utils?|Handler)\b"/>
      <property name="message" value="禁用类后缀 Manager/Helper/Util(s)/Handler（开发规范 §2.1）：说不出职责说明类该拆；MQ/事件入口用 XxxConsumer"/>
      <property name="severity" value="error"/>
    </module>

    <!-- 规范 §2.2：裸 DTO 后缀信息量为零，按层用 Request/Response/Command/Query/Result/PO -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="\b(class|record)\s+\w+DTO\b"/>
      <property name="message" value="禁止裸 DTO 后缀（开发规范 §2.2）：interfaces 层用 Request/Response，application 层用 Command/Query/Result，持久化用 PO"/>
      <property name="severity" value="error"/>
    </module>

    <!-- 规范 §4.1：量纲入名（本项目最重要的变量规则，单位错误是真实事故源）。
         best-effort 正则，告警级：尺寸/金额/时长词根的数值变量缺单位后缀（Mm/Sqm/Cents/Ms/Seconds） -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="\b(int|long|float|double|Integer|Long|Float|Double|BigDecimal)\s+\w*(?i)(width|height|length|depth|area|price|amount|timeout|duration)(?!(?i)(Mm|Sqm|Cents|Ms|Seconds|Millis))\b\w*"/>
      <property name="message" value="量纲入名（开发规范 §4.1）：长度 Mm（全链路毫米）、面积 Sqm、金额 Cents、时长 Ms/Seconds，如 wallLengthMm / priceCents"/>
      <property name="severity" value="warning"/>
    </module>
  </module>
</module>
